{
  "name": "headlamp-credentials",
  "version": "0.1.0",
  "description": "Open Badges 3.0 issuing and verification library for the Headlamp SkillBridge Credential. Pure functions in, signed JSON out.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "headlamp-credentials": "./bin/headlamp-credentials.js"
  },
  "files": [
    "dist",
    "bin",
    "docs/API.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepare": "npm run build",
    "typecheck:all": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@digitalbazaar/credentials-context": "^3.2.0",
    "@digitalbazaar/data-integrity": "^2.5.0",
    "@digitalbazaar/data-integrity-context": "^2.0.1",
    "@digitalbazaar/ed25519-multikey": "^1.3.1",
    "@digitalbazaar/eddsa-rdfc-2022-cryptosuite": "^1.3.0",
    "@digitalbazaar/multikey-context": "^2.0.1",
    "@digitalbazaar/vc": "^7.3.0",
    "@digitalbazaar/vc-bitstring-status-list": "^2.0.1",
    "@digitalcredentials/open-badges-context": "^3.0.0",
    "did-context": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.18.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
