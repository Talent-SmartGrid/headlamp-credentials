{
  "name": "headlamp-extraction",
  "version": "0.1.0",
  "description": "Document text extraction prototype for Headlamp SkillBridge credentialing. Plain text in, structured field candidates out. Parsing utility only — NOT part of the audited signing core.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden:update": "UPDATE_GOLDEN=1 vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:all": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
